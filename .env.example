# Copiar como .env (en la raíz del repo) y completar. El archivo .env nunca se sube al repositorio.

# --- Base de datos ---
# Opción A: Azure SQL con tu cuenta de Microsoft (la primera consulta abre el inicio de sesión en el navegador)
DB_SERVER=tcp:donaria-eric-sql.database.windows.net,1433
DB_NAME=DonariaConnect
DB_AUTH=entra-interactive
DB_USER=tu-correo@alum.udep.edu.pe

# Opción B: SQL Server local con autenticación de Windows
# DB_SERVER=localhost\SQLEXPRESS
# DB_AUTH=windows

# Otras: DB_AUTH=entra-msi (en Azure App Service) o DB_AUTH=sql con DB_USER y DB_PASSWORD
DB_DRIVER=ODBC Driver 18 for SQL Server

# --- API ---
# Clave para firmar los tokens: cualquier texto largo (32+ caracteres) que solo tú conozcas.
JWT_SECRET=
# Fecha "de hoy" para la elegibilidad. Los datos ficticios están pensados para 2026-11-09.
FECHA_REFERENCIA=2026-11-09
CORS_ORIGINS=*

# --- Integraciones (fases 4 y 5) ---
# Didit (fase 4): consola de Didit → tu aplicación → API Keys / Workflows. Sin esto la verificación queda simulada.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Solo cuando la API esté publicada (fase 6): Didit enviará el resultado a https://<tu-api>/webhooks/didit
DIDIT_WEBHOOK_SECRET=
# WhatsApp (fase 5): Meta for Developers → tu app → WhatsApp → Configuración de la API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Celulares registrados como destinatarios de prueba en Meta (9 dígitos o con 51), separados por comas.
# Solo a estos se les envía; a los donantes ficticios nunca.
WHATSAPP_NUMEROS_PRUEBA=
# Plantilla aprobada: convocatoria_donacion (es) con {{1}} institución, {{2}} tipo, {{3}} km. Para probar: hello_world (en_US)
WHATSAPP_PLANTILLA=convocatoria_donacion
WHATSAPP_IDIOMA=es
