# Copiar como .env (en la raíz del repo) y completar. El archivo .env nunca se sube al repositorio.

# --- Base de datos ---
# Opción A: Azure SQL con tu cuenta de Microsoft (abre la ventana de inicio de sesión)
DB_SERVER=tcp:donaria-eric-sql.database.windows.net,1433
DB_NAME=DonariaConnect
DB_AUTH=entra-interactive
DB_USER=tu-correo@alum.udep.edu.pe

# Opción B: SQL Server local con autenticación de Windows
# DB_SERVER=localhost\SQLEXPRESS
# DB_AUTH=windows

# Otras: DB_AUTH=entra-msi (en Azure App Service) o DB_AUTH=sql con DB_USER y DB_PASSWORD
DB_DRIVER=ODBC Driver 18 for SQL Server

# --- API ---
# Clave para firmar los tokens: cualquier texto largo (32+ caracteres) que solo tú conozcas.
JWT_SECRET=
# Fecha "de hoy" para la elegibilidad. Los datos ficticios están pensados para 2026-11-09.
FECHA_REFERENCIA=2026-11-09
CORS_ORIGINS=*

# --- Integraciones (fases 4 y 5) ---
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
